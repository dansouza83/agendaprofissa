# Modo online: preencha com os dados públicos do seu projeto Supabase.
# Nunca coloque service_role ou secret key no frontend.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave pública do widget Cloudflare Turnstile. A chave secreta fica somente
# em Supabase Auth > Bot and Abuse Protection — nunca a coloque neste arquivo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Somente para desenvolvimento em localhost. Nunca habilite em hospedagem.
NEXT_PUBLIC_ALLOW_LOCAL_SIGNUP_WITHOUT_CAPTCHA=false

# As credenciais privadas do Mercado Pago ficam no Supabase Vault.
# As operações privilegiadas são executadas em Supabase Edge Functions.
